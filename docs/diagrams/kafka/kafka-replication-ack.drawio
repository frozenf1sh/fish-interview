<mxfile host="app.diagrams.net" modified="2026-08-28T00:00:00.000Z" agent="Fish Interview" version="31.1.8">
  <diagram id="kafka-replication-ack" name="Kafka ISR 与 ACK">
    <mxGraphModel adaptiveColors="auto" dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="producer" value="Producer&lt;br&gt;acks=all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff6e5;strokeColor=#d99b3d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="220" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="leader" value="Broker 1&lt;br&gt;P0 Leader&lt;br&gt;append offset 100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0d7;strokeColor=#d99b3d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="170" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="follower1" value="Broker 2&lt;br&gt;Follower&lt;br&gt;offset 100 · ISR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f3e8;strokeColor=#5c9a70;" vertex="1" parent="1"><mxGeometry x="690" y="80" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="follower2" value="Broker 3&lt;br&gt;Follower&lt;br&gt;offset 99 · ISR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f3e8;strokeColor=#5c9a70;" vertex="1" parent="1"><mxGeometry x="690" y="270" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="ack" value="ProduceResponse&lt;br&gt;满足 ISR 确认后成功" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0ff;strokeColor=#6d91c7;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="430" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="minisr" value="min.insync.replicas=2&lt;br&gt;ISR 少于 2 时拒绝高可靠写入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde9e9;strokeColor=#c87979;" vertex="1" parent="1"><mxGeometry x="690" y="460" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="e1" value="ProduceRequest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#d99b3d;" edge="1" parent="1" source="producer" target="leader"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Follower Fetch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#5c9a70;" edge="1" parent="1" source="leader" target="follower1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Follower Fetch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#5c9a70;" edge="1" parent="1" source="leader" target="follower2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="ACK 条件满足" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#6d91c7;" edge="1" parent="1" source="leader" target="ack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#c87979;" edge="1" parent="1" source="follower2" target="minisr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="acks=all 等待当前 ISR；min.insync.replicas 规定最低 ISR 数，不等于等待所有历史副本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b8c9bb;fontColor=#31543a;" vertex="1" parent="1"><mxGeometry x="100" y="610" width="900" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
